enum PrescriptionType {
  fillup
  photo
}

model Cart {
  id                     String     @id @default(auto()) @map("_id") @db.ObjectId
  user                   User?      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user_id                String?    @unique @db.ObjectId
  temp_session_id        String?    @unique // Guest cart identifier; cleared when attached to user
  checkout_initiated     Boolean?   @default(false)
  items                  CartItem[]
  coupon                 Coupon?    @relation(fields: [coupon_id], references: [id])
  coupon_id              String?    @db.ObjectId // Nullable if no coupon is applied
  /** When the coupon was applied; used to auto-release after 24h if order not placed. */
  coupon_applied_at      DateTime?
  /** True when coupon.quantity was decremented for this cart reservation. */
  coupon_quantity_locked Boolean?   @default(false)
  created_at             DateTime   @default(now())
  updated_at             DateTime   @updatedAt
}

model CartItem {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  cart    Cart   @relation(fields: [cart_id], references: [id], onUpdate: Cascade, onDelete: Cascade)
  cart_id String @db.ObjectId

  product_color    ProductColor @relation(fields: [product_color_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product_color_id String       @db.ObjectId

  power_type    PowerType? @relation(fields: [power_type_id], references: [id])
  power_type_id String?    @db.ObjectId

  lens_feature    LensFeature? @relation(fields: [lens_feature_id], references: [id])
  lens_feature_id String?      @db.ObjectId

  lens_detail    LensDetail? @relation(fields: [lens_detail_id], references: [id])
  lens_detail_id String?     @db.ObjectId

  frame_only Boolean @default(false)

  prescription Json? // refer to prescription schema
  quantity     Int      @default(1)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([cart_id])
}
