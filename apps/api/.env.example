# Server
DEV_ENVIRONMENT="true"
ALLOWED_ORIGINS="http://localhost:3000"
ALLOWED_HEADERS="Content-Type,Authorization"
CREDENTIALS="true"
SECRET_KEY="change-me"

# API
GLOBAL_PREFIX="/v1"

# Redis HTTP cache (@Cacheable / @InvalidateCache). Off unless CACHE_ENABLED=true.
# Legacy: CACHE_REDIS_ENABLED=true also enables cache during migration.
# CACHE_ENABLED="false"
# REDIS_URL="redis://127.0.0.1:6379"
# REDIS_HOST="127.0.0.1"
# REDIS_PORT="6379"
# REDIS_PASSWORD=""
# REDIS_DB="0"

# Database (MongoDB)
# DATABASE_URL="mongodb://..."

# Puppeteer / PDF (invoice PDF generation)
# Local: run `bun run puppeteer:install` after install, or point at system Chrome:
# PUPPETEER_EXECUTABLE_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Docker sets PUPPETEER_CACHE_DIR and skips download during bun install.
# PUPPETEER_CACHE_DIR="/var/www/api/.cache/puppeteer"
# PUPPETEER_SKIP_DOWNLOAD="true"

# Delhivery
# DELIVERY_API_KEY=""
# MANIFEST_ORDER_API="https://track.delhivery.com/api/cmu/create.json"
# TRACKING_URL="https://track.delhivery.com/api/v1/packages/json/"
# PINCODE_SERVICEABILITY_URL="https://track.delhivery.com/c/api/pin-codes/json/"
# DELIVERY_PICKUP_LOCATION=""
# DELIVERY_CLIENT_NAME=""
